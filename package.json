{
  "name": "trust-node",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @trust-node/dashboard dev",
    "dev:widget": "pnpm --filter @trust-node/widget dev",
    "build": "pnpm --filter @trust-node/widget build && pnpm --filter @trust-node/dashboard build",
    "build:dashboard": "pnpm --filter @trust-node/dashboard build",
    "build:widget": "pnpm --filter @trust-node/widget build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @trust-node/dashboard db:generate",
    "db:push": "pnpm --filter @trust-node/dashboard db:push",
    "db:migrate": "pnpm --filter @trust-node/dashboard db:migrate",
    "db:studio": "pnpm --filter @trust-node/dashboard db:studio"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "svelte-preprocess",
      "sharp"
    ]
  },
  "dependencies": {
    "autoprefixer": "^10.5.0"
  }
}
